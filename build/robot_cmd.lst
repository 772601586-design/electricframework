 184:application/cmd/robot_cmd.c ****         gimbal_cmd_send.pitch >= robot_config->gimbal_param.gimbal_offset.pitch_max_angle)
 185:application/cmd/robot_cmd.c ****     { // 云台yaw轴/pitch轴正向偏移
 186:application/cmd/robot_cmd.c ****         if (add_yaw < 0.0f)
 187:application/cmd/robot_cmd.c ****             gimbal_cmd_send.yaw -= add_yaw;
 188:application/cmd/robot_cmd.c **** 
 189:application/cmd/robot_cmd.c ****         if (add_pitch > 0.0f)
 190:application/cmd/robot_cmd.c ****             gimbal_cmd_send.pitch -= add_pitch;
 191:application/cmd/robot_cmd.c ****     }
 192:application/cmd/robot_cmd.c ****     if (chassis_cmd_send.offset_angle - fabs(bias_angle) <= -90.0f ||
 193:application/cmd/robot_cmd.c ****         gimbal_cmd_send.pitch <= robot_config->gimbal_param.gimbal_offset.pitch_min_angle)
 194:application/cmd/robot_cmd.c ****     { // 云台yaw轴/pitch轴负向偏移            
 195:application/cmd/robot_cmd.c ****         if (add_yaw > 0.0f)
 196:application/cmd/robot_cmd.c ****             gimbal_cmd_send.yaw -= add_yaw;
 197:application/cmd/robot_cmd.c **** 
 198:application/cmd/robot_cmd.c ****         if (add_pitch < 0.0f)
 199:application/cmd/robot_cmd.c ****             gimbal_cmd_send.pitch -= add_pitch;    
 200:application/cmd/robot_cmd.c ****     }
 201:application/cmd/robot_cmd.c **** }
