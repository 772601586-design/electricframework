{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "DAPLink: Build and Debug",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/basic_framework.elf",
            "gdbPath": "D:/app/arm.gnu/bin/arm-none-eabi-gdb.exe",
            "servertype": "openocd",
            "serverpath": "D:/ClionToolchains/OpenOCD-20231002-0.12.0/bin/openocd.exe",
            "configFiles": [
                "${workspaceFolder}/openocd_dap.cfg"
            ],
            "device": "STM32F407IG",
            "svdFile": "${workspaceFolder}/STM32F407.svd",
            "runToEntryPoint": "main",
            "rtos": "FreeRTOS",
            "preLaunchTask": "Build",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        {
            "name": "DAPLink: Attach",
            "type": "cortex-debug",
            "request": "attach",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/basic_framework.elf",
            "gdbPath": "D:/app/arm.gnu/bin/arm-none-eabi-gdb.exe",
            "servertype": "openocd",
            "serverpath": "D:/ClionToolchains/OpenOCD-20231002-0.12.0/bin/openocd.exe",
            "configFiles": [
                "${workspaceFolder}/openocd_dap.cfg"
            ],
            "device": "STM32F407IG",
            "svdFile": "${workspaceFolder}/STM32F407.svd",
            "rtos": "FreeRTOS",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        {
            "name": "J-Link: Build and Debug",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/basic_framework.elf",
            "servertype": "jlink",
            "interface": "swd",
            "device": "STM32F407IG",
            "svdFile": "${workspaceFolder}/STM32F407.svd",
            "runToEntryPoint": "main",
            "rtos": "FreeRTOS",
            "preLaunchTask": "Build",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        {
            "name": "J-Link: Attach",
            "type": "cortex-debug",
            "request": "attach",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/basic_framework.elf",
            "servertype": "jlink",
            "interface": "swd",
            "device": "STM32F407IG",
            "svdFile": "${workspaceFolder}/STM32F407.svd",
            "rtos": "FreeRTOS",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        }
    ]
}
